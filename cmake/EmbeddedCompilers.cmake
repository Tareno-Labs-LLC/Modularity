option(MODULARITY_ENABLE_EMBEDDED_COMPILERS "Embed Cling and TinyCC in the Android editor" OFF)
set(MODULARITY_EMBEDDED_COMPILERS_ROOT "" CACHE PATH "Target compiler prefix from setup-embedded-compilers.py")
if(MODULARITY_ENABLE_EMBEDDED_COMPILERS)
    if(NOT ANDROID OR NOT CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
        message(FATAL_ERROR "The embedded editor compiler bundle currently targets Android arm64-v8a.")
    endif()
    set(_embedded "${MODULARITY_EMBEDDED_COMPILERS_ROOT}")
    foreach(required include/cling/Interpreter/Interpreter.h include/libtcc.h lib/libmodularity_tinycc.a runtime-libraries.txt ready.json)
        if(NOT EXISTS "${_embedded}/${required}")
            message(FATAL_ERROR "Embedded compiler dependency ${required} is missing. Run python tools/setup-embedded-compilers.py.")
        endif()
    endforeach()
    add_library(modularity_embedded_compilers INTERFACE)
    target_include_directories(modularity_embedded_compilers SYSTEM INTERFACE "${_embedded}/include")
    file(STRINGS "${_embedded}/runtime-libraries.txt" _embedded_libraries)
    if(NOT _embedded_libraries)
        message(FATAL_ERROR "Embedded compiler runtime library list is empty.")
    endif()
    foreach(library IN LISTS _embedded_libraries)
        if(NOT library MATCHES "^lib[A-Za-z0-9_.+-]+[.]so$" OR NOT EXISTS "${_embedded}/lib/${library}")
            message(FATAL_ERROR "Invalid or missing Android compiler runtime library: ${library}")
        endif()
        target_link_libraries(modularity_embedded_compilers INTERFACE "${_embedded}/lib/${library}")
    endforeach()
    target_link_libraries(modularity_embedded_compilers INTERFACE "${_embedded}/lib/libmodularity_tinycc.a")
endif()
