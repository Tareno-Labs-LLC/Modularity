# TinyCC is compiled for the target, not the machine running CMake.
if(NOT EXISTS "${MODULARITY_TINYCC_SOURCE_DIR}/libtcc.c")
    message(FATAL_ERROR "TinyCC sources missing. Run python tools/setup-embedded-compilers.py --fetch first.")
endif()
set(_tcc_config "${CMAKE_CURRENT_BINARY_DIR}/tinycc-config")
file(MAKE_DIRECTORY "${_tcc_config}")
file(WRITE "${_tcc_config}/config.h" "#define TCC_VERSION \"0.9.28-modularity\"\n#define CONFIG_TCC_PREDEFS 0\n#define CONFIG_TCC_BCHECK 0\n#define CONFIG_TCC_BACKTRACE 0\n#define CONFIG_TCC_SEMLOCK 1\n#define CONFIG_TCCDIR \".\"\n")
add_library(modularity_tinycc STATIC "${MODULARITY_TINYCC_SOURCE_DIR}/libtcc.c")
set_target_properties(modularity_tinycc PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(modularity_tinycc PUBLIC "${MODULARITY_TINYCC_SOURCE_DIR}" PRIVATE "${_tcc_config}")
set(MODULARITY_TINYCC_TARGET "native" CACHE STRING "TinyCC code-generation target: native or android-arm64")
if(MODULARITY_TINYCC_TARGET STREQUAL "android-arm64" OR (ANDROID AND CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a"))
    target_compile_definitions(modularity_tinycc PRIVATE TCC_TARGET_ARM64=1 TARGETOS_ANDROID=1 CONFIG_TCC_PIC=1)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    target_compile_definitions(modularity_tinycc PRIVATE TCC_TARGET_ARM64=1)
elseif(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    target_compile_definitions(modularity_tinycc PRIVATE TCC_TARGET_X86_64=1 TCC_TARGET_PE=1)
elseif(CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT MSVC)
    target_compile_definitions(modularity_tinycc PRIVATE TCC_TARGET_X86_64=1)
else()
    message(FATAL_ERROR "Embedded TinyCC currently supports Android ARM64 and x86-64/ARM64 hosts.")
endif()
if(NOT WIN32)
    find_package(Threads REQUIRED)
    target_link_libraries(modularity_tinycc PUBLIC ${CMAKE_DL_LIBS} m Threads::Threads)
endif()
